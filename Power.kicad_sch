	(text "12V 10W Power Supply"
		(exclude_from_sim no)
		(at 170.18 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0d778311-cf1b-4e4c-a60d-a6547781b29d")
	)
	(text "U7 boosts USB_VBUS to 11.5 V on VIN through D2, so the board can\nrun from USB alone with a correct VIN voltage and full ADC\nperformance. With mains connected, U5 feeds VIN through D7."
		(exclude_from_sim no)
		(at 166.37 28.448 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "39d948f2-a464-4984-8427-e40a4986a080")
	)
	(text "F2 and F3 are the two clips of one 5x20 mm fuse. It carries U5, the\nthree solenoids and, if fitted, the stock rotary pump, and protects the PCB.\nType: time-lag (T), ceramic high-breaking (H), 250 VAC.\nSuggested rating:\n230 VAC, stock rotary pump: T2.5A (about 1.6 A running)\n230 VAC, gear pump fed from J5, or no pump: T1A (about 0.4 A running)\n110 VAC, stock rotary pump: T4A (about 3.1 A running)\n110 VAC, gear pump fed from J5, or no pump: T1.6A (about 0.8 A running)\nRunning currents are estimates. Check your motor's nameplate, and keep\nat least 25% margin.\nMaximum: T5A, at either voltage. A T5A may hold 7.5 A for an hour, and the\n2.5 mm, 35 um tracks then rise about 30 K. Keep I2t well below 600 A2s."
		(exclude_from_sim no)
		(at 19.05 126.238 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "594ea732-5f56-4535-b01e-526013b19c0a")
	)
	(text "Ground domains:\nGND: main ground, and the return of U5.\nGND1: load cell ground. Joined to GND only at NT1.\nGNDA: ADC ground. No link to GND on this board: both go into the SoM (U1).\nGNDPWR: 24 V return, from J5 pin 1. Isolated from GND by U16.\nR2 (100M) is the only link, so GNDPWR can't float far from GND\nand develop high relative voltages."
		(exclude_from_sim no)
		(at 19.558 67.564 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "64a18f6c-64cb-40d3-931c-33fe2203e4c1")
	)
	(text "82/10 gives us 11.5 V output."
		(exclude_from_sim no)
		(at 149.352 68.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7a46e109-1fe2-46cc-8cf5-a76f2aaf30be")
	)
