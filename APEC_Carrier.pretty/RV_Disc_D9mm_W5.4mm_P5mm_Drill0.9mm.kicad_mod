(footprint "RV_Disc_D9mm_W5.4mm_P5mm_Drill0.9mm"
  (version 20240108)
  (generator "konnect")
  (layer "F.Cu")
  (descr "Varistor, diameter 9mm, width 5.4mm, pitch 5mm (TDK S07 / 7 mm disc). Same pad positions and outline as KiCad's RV_Disc_D9mm_W5.4mm_P5mm, with a 0.9 mm drill and 2.0 mm pad: the stock 0.6 mm hole is too tight for 0.6 +/-0.05 mm leads.")
  (attr through_hole)
  (pad "1" thru_hole circle (at 0 0) (size 2 2) (layers "*.Cu" "*.Mask") (drill 0.9) )
  (pad "2" thru_hole circle (at 5 2.8) (size 2 2) (layers "*.Cu" "*.Mask") (drill 0.9) )
  (fp_rect (start -2.25 -1.55) (end 7.25 4.35) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_rect (start -2 -1.3) (end 7 4.1) (stroke (width 0.15) (type solid)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -2 -1.3) (end 7 4.1) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_text reference "REF**" (at 2.5000 -2.5000 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "RV_Disc_D9mm_W5.4mm_P5mm_Drill0.9mm" (at 2.5000 5.3000 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (model "${KICAD10_3DMODEL_DIR}/Varistor.3dshapes/RV_Disc_D9mm_W5.4mm_P5mm.step"
    (offset (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0)))
)