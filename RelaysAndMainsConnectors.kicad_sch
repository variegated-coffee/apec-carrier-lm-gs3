	(text "WARNING: MAINS VOLTAGE (110 OR 230 VAC) ON THIS SHEET.\nPH, PH_UNFUSED, N, ROTARY_PUMP, GROUP_SOLENOID, FILL_SOLENOID and TEA_SOLENOID\nare all hazardous. Treat N as live: it can carry line voltage with an unpolarised plug.\nNet classes 230VAC-16A and 230VAC-5A keep 2.4 mm between these nets and other copper.\nDo not route low-voltage copper across the isolation slots.\n\nU9, U10 and U11 (ALDP112) are mechanical relays, not SSRs, despite the U prefix."
		(exclude_from_sim no)
		(at 44.45 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5f96e4cb-966f-4be6-b52c-80b05348b4a6")
	)
	(text "J2 mains terminals:\n1 = PH_UNFUSED, 3 and 4 = N, 5 = ROTARY_PUMP, 6 = GROUP_SOLENOID,\n10 = FILL_SOLENOID, 11 = TEA_SOLENOID.\nPins 2, 7, 8, 9, 12 and 13 are not connected on this board."
		(exclude_from_sim no)
		(at 44.45 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "cdcd4c2a-e265-4c56-a5b4-1ed85778e0fe")
	)
