(version 1)
#Kicad 7

# 2-layer, 1oz copper
(rule "Minimum Trace Width (outer layer)"
	(constraint track_width (min 3.5mil))
	(layer outer)
	(condition "A.Type == 'track'"))

(rule "Minimum Trace Spacing (outer layer)"
	(constraint clearance (min 3.5mil))
	(layer outer)
	(condition "A.Type == 'track' && B.Type == A.Type"))

# 4-layer
(rule "Minimum Trace Width and Spacing (inner layer)"
	(constraint track_width (min 3.5mil))
	(layer inner)
	(condition "A.Type == 'track'"))

(rule "Minimum Trace Spacing (inner layer)"
	(constraint clearance (min 3.5mil))
	(layer inner)
	(condition "A.Type == 'track' && B.Type == A.Type"))

# silkscreen (Kicad 7 only)
(rule "Minimum Text"
	(constraint text_thickness (min 0.15mm))
	(constraint text_height (min 1mm))
	(layer "?.Silkscreen"))

(rule "Pad to Silkscreen"
	(constraint silk_clearance (min 0.15mm))
	(layer outer)
	(condition "A.Type == 'pad' && (B.Type == 'text' || B.Type == 'graphic')"))

# edge clearance
(rule "Trace to Outline"
	(constraint edge_clearance (min 0.2mm))
	(condition "A.Type == 'track'"))

# This would override board outline and milled areas
#(rule "Trace to V-Cut"
#	(constraint clearance (min 0.4mm))
#	(condition "A.Type == 'track' && B.Layer == 'Edge.Cuts'"))

# drill/hole size
(rule "drill hole size (mechanical)"
	(constraint hole_size (min 0.2mm) (max 6.3mm)))

(rule "Minimum Via Hole Size"
	(constraint hole_size (min 0.15mm))
	(condition "A.Type == 'via'"))

(rule "Minimum Via Diameter"
	(constraint via_diameter (min 0.25mm))
	(condition "A.Type == 'via'"))

(rule "PTH Hole Size"
	(constraint hole_size (min 0.2mm) (max 6.35mm))
	(condition "A.isPlated() && A.Type != 'via'"))

(rule "Minimum Non-plated Hole Size"
	(constraint hole_size (min 0.5mm))
	(condition "A.Type == 'pad' && !A.isPlated()"))
	
(rule "Minimum Castellated Hole Size"
	(constraint hole_size (min 0.6mm))
	(condition "A.Type == 'pad' && A.Fabrication_Property == 'Castellated pad'"))

# clearance
(rule "hole to hole clearance (different nets, non-vias)"
	(constraint hole_to_hole (min 0.5mm))
	(condition "A.Net != B.Net && A.Type != 'via' && B.Type != 'via'"))

(rule "via to track clearance"
	(constraint hole_clearance (min 0.2mm))
	(condition "A.Type == 'via' && B.Type == 'track'"))

(rule "via to via clearance"
	(constraint hole_to_hole (min 0.254mm))
	(condition "A.Type == 'via' && B.Type == A.Type"))

(rule "pad to pad clearance (with hole, different nets)"
	(constraint hole_to_hole (min 0.5mm))
	(condition "A.Type == 'pad' && B.Type == A.Type && A.Net != B.Net"))

(rule "pad to pad clearance (without hole, different nets)"
	(constraint clearance (min 0.15mm))
	(condition "A.Type == 'pad' && B.Type == A.Type && A.Net != B.Net"))

(rule "NPTH to Track clearance)"
	(constraint hole_clearance (min 0.254mm))
	(condition "A.Pad_Type == 'NPTH, mechanical' && B.Type == 'track'"))

(rule "PTH to Track clearance)"
	(constraint hole_clearance (min 0.33mm))
	(condition "A.isPlated() && A.Type != 'via' && B.Type == 'track'"))

(rule "Pad to Track clearance)"
	(constraint clearance (min 0.2mm))
	(condition "A.isPlated() && B.Type == 'track' && A.Layer == B.Layer"))

# J14 (USB-C): the pad to NPTH peg hole gap comes from the connector's footprint.
# Actual gaps are 0.175 mm and 0.210 mm, against the 0.25 mm board minimum.
(rule "J14 pad to NPTH hole clearance waiver"
	(constraint hole_clearance (min 0.17mm))
	(condition "A.memberOfFootprint('J14') && B.memberOfFootprint('J14')"))

# Net class spacing. These must stay after the fab minimums above, because later rules
# take precedence and the fab minimums would otherwise replace the net class clearance.
# Order them by increasing clearance, so that the larger value wins between two classes.
(rule "Default clearance"
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('Default')"))

(rule "GND1 clearance"
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('GND1')"))

(rule "PWR_DIST clearance"
	(constraint clearance (min 0.2mm))
	(condition "A.hasNetclass('PWR_DIST')"))

(rule "12V-1A clearance"
	(constraint clearance (min 0.25mm))
	(condition "A.hasNetclass('12V-1A')"))

(rule "24V-2A clearance"
	(constraint clearance (min 0.25mm))
	(condition "A.hasNetclass('24V-2A')"))

# Mains spacing. These must stay last: later rules take precedence, so otherwise the
# fab minimums above would replace the net class clearance.
(rule "230VAC-16A clearance"
	(constraint clearance (min 2.4mm))
	(condition "A.hasNetclass('230VAC-16A')"))

(rule "230VAC-5A clearance"
	(constraint clearance (min 2.4mm))
	(condition "A.hasNetclass('230VAC-5A')"))

# K1's normally-closed contact (pin 12) is not connected, so it has no net class, but it
# carries line voltage whenever the relay is off. Treat it as mains. Keep this last.
(rule "K1 NC contact clearance"
	(constraint clearance (min 2.4mm))
	(condition "A.memberOfFootprint('K1') && A.Pad_Number == '12'"))
