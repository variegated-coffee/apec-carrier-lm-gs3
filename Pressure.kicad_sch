	(text "RC filter at the ADC pin: 33K / 47 nF, ~100 Hz.\nCap on the ADC side: the sensor never sees it.\nThe 33K also limits fault current into the ADC\nif the signal wire is shorted."
		(exclude_from_sim no)
		(at 109.474 70.104 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6107e0be-989d-4d8b-bcea-780f61b10f0c")
	)
	(text "R8 = 0R, C51 = 100 nF at the REFP1/REFN1 pins.\nREFP1 sits at AVDD, so its buffer must be off;\nthe unbuffered input draws ~4 uA/V, so any series\nresistance here makes the reference read low."
		(exclude_from_sim no)
		(at 63.754 131.572 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8464c685-789d-4486-b341-11a3cc5b99a7")
	)
	(text "RC filter at the ADC pin: 33K / 47 nF, ~100 Hz.\nCap on the ADC side: the sensor never sees it.\nThe 33K also limits fault current into the ADC\nif the signal wire is shorted."
		(exclude_from_sim no)
		(at 53.848 33.782 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c2f0c016-c12e-4c89-b2d1-2f9a587ddc57")
	)
