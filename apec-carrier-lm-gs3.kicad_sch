	(text "I2C requires pull-ups. Technically you could use pull-ups \nin the MCU, but using discrete pull-ups means less problems\nat reset."
		(exclude_from_sim no)
		(at 703.326 550.672 0)
		(effects
			(font
				(size 1.27 1.27)
			)
