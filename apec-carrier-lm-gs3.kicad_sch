	)
	(text "TACHO OUT has to be a PWM B pin, if you want to use \nthe PWM to measure frequency. If so, the A pin should \nnot be used for PWM. GP33 is a B pin."
		(exclude_from_sim no)
		(at 117.602 156.464 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "de08a818-6546-4323-a600-0151a2a88440")
	)
	(text "These are both configured for a two-wire PT1000 measurement.\nTo change to three-wire or four-wire, you can cut/solder jumpers\naccording to SBAA275A. The filter resistors and capacitors should\nalso be changed.\n\nSimilarly, to change to PT100, you can change filter resistors and \ncapacitors."
		(exclude_from_sim no)
		(at 1061.72 749.554 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e61f281b-ee5c-4a7d-a82c-12e30da21cc6")
	)
