	)
	(text "Using an SD card is of course optional. This\nparticular design is further complicated by\nusing a 4-bit SDIO bus instead of the 1-bit\nSPI option."
		(exclude_from_sim no)
		(at 511.556 39.878 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
