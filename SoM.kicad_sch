	(text "I2C Address summary\n\nI2C0 (QWIIC_SCL/SDA, GP16/17)\n\n0x68: DS3231\nQwiic connectors J4, J15, J16\nDisplay connectors J13, J17\n\nI2C1 (INT_SCL/SDA, SoM internal)\n\n0x2A: NAU7802 (via Q30)\n0x50: FDC1004 (on the SoM)\n"
		(exclude_from_sim no)
		(at 157.734 32.004 0)
		(effects
			(font
				(size 1.27 1.27)
			)
